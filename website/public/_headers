# Response headers for the static assets.
# no-transform keeps Cloudflare from injecting its Web Analytics script into the pages (it is enabled for the whole
# zawalid.com zone, for Rimline). This site has no analytics.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/404.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/compare/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/apps/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# /_astro files are content-hashed, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=86400
