---
import '../styles/global.css';
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import { links, site, version } from '../data/site';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, for the canonical link. */
  path?: string;
  /** Whether this is the home page, where the section links are in-page. */
  home?: boolean;
  extraJsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title = site.title, description = site.description, path = '/', home = false, extraJsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, site.url).toString();
const ogImage = new URL('/og.png', site.url).toString();
const at = home ? '' : '/';

const nav = [
  { id: 'gap', label: 'Why' },
  { id: 'how', label: 'How it works' },
  { id: 'holding', label: 'Actions' },
  { id: 'apps', label: 'Apps' },
  { id: 'yours', label: 'Your commands' },
  { id: 'compare', label: 'Compare' },
  { id: 'private', label: 'Privacy' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: site.name,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: `macOS ${site.minimumMacOS} or later`,
    softwareVersion: version,
    description: site.description,
    url: site.url,
    downloadUrl: links.download,
    author: { '@type': 'Person', name: 'Walid', url: links.author },
  },
  ...extraJsonLd,
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F3F5F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1418" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top" data-top>
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Apropos home">
          <Image src={icon} alt="" width={28} height={28} densities={[1, 2, 3]} loading="eager" />
          <span>Apropos</span>
        </a>
        <nav class="sections" aria-label="Sections">
          <ul data-nav>
            {nav.map((item) => (
              <li><a href={`${at}#${item.id}`} data-for={item.id}>{item.label}</a></li>
            ))}
          </ul>
          <span class="nav-bead" data-nav-bead aria-hidden="true"></span>
        </nav>
        <a class="get" href={`${at}#install`} data-get>Download</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion';
      import '../scripts/page';
    </script>
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms var(--ease);
  }
  @supports (backdrop-filter: blur(1px)) {
    .top {
      background: color-mix(in srgb, var(--paper) 78%, transparent);
      backdrop-filter: saturate(1.4) blur(14px);
    }
  }
  :global(html.scrolled) .top {
    border-bottom-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.02em;
    flex: none;
  }
  .brand img {
    width: 28px;
    height: 28px;
  }
  .sections {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
  }
  .sections ul {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 6px 2px 10px;
    margin-bottom: -4px;
  }
  .sections ul::-webkit-scrollbar {
    display: none;
  }
  .sections a {
    display: block;
    padding: 6px 11px;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms var(--ease);
  }
  .sections a:hover,
  .sections a[aria-current='true'] {
    color: var(--ink);
  }
  .nav-bead {
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--pearl);
    box-shadow: 0 0 8px var(--pearl-glow);
    opacity: 0;
    transform: translateX(var(--x, 0px));
    transition:
      transform 420ms var(--spring),
      opacity 200ms var(--ease);
    pointer-events: none;
  }
  :global(html.docked) .nav-bead {
    opacity: 1;
  }
  .get {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--pill);
    color: var(--pill-ink);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 200ms var(--ease),
      transform 200ms var(--ease),
      visibility 0s linear 200ms;
  }
  :global(html.past-hero) .get {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  @media (max-width: 860px) {
    .sections {
      display: none;
    }
    .bar {
      justify-content: space-between;
    }
  }
</style>
