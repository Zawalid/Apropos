---
import '../styles/global.css';
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import { links, site, version } from '../data/site';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import wallpaper from '../assets/wallpaper-night.webp';
const desk = await getImage({ src: wallpaper, width: 1800, format: 'webp', quality: 70 });

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, for the canonical link. */
  path?: string;
  /** Whether this is the home page, where the section links are in-page. */
  home?: boolean;
  extraJsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title = site.title, description = site.description, path = '/', home = false, extraJsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, site.url).toString();
const ogImage = new URL('/og.png', site.url).toString();
const at = home ? '' : '/';

const nav = [
  { id: 'deep', label: 'Menus' },
  { id: 'apps', label: 'Apps' },
  { id: 'holding', label: 'Selection' },
  { id: 'send', label: 'Send' },
  { id: 'next', label: 'Learns' },
  { id: 'yours', label: 'Yours' },
  { id: 'compare', label: 'Compare' },
  { id: 'private', label: 'Privacy' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: site.name,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: `macOS ${site.minimumMacOS} or later`,
    softwareVersion: version,
    description: site.description,
    url: site.url,
    downloadUrl: links.download,
    author: { '@type': 'Person', name: 'Walid', url: links.author },
  },
  ...extraJsonLd,
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F3F5F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1418" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="desk" aria-hidden="true"><img src={desk.src} alt="" width="1800" height="1164" decoding="async" /></div>
    <header class="top" data-top>
      <div class="bar">
        <a class="brand" href="/" aria-label="Apropos home">
          <Image src={icon} alt="" width={28} height={28} densities={[1, 2, 3]} loading="eager" />
          <span>Apropos</span>
        </a>
        <nav class="sections" aria-label="Sections">
          <ul data-nav>
            {nav.map((item) => (
              <li><a href={`${at}#${item.id}`} data-for={item.id}>{item.label}</a></li>
            ))}
          </ul>
          <span class="nav-bead" data-nav-bead aria-hidden="true"></span>
        </nav>
        <a class="get" href={`${at}#install`}>Download</a>
      </div>
    </header>
    <main id="main">
      {home ? <slot /> : <div class="sheet page-sheet" data-light="day"><slot /></div>}
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  /* The header floats over both lights: a capsule that takes the colours of whatever scene is under it. */
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 12px var(--gutter) 0;
    pointer-events: none;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: calc(var(--max) + 48px);
    margin-inline: auto;
  }
  .brand,
  .sections,
  .get {
    pointer-events: auto;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 44px;
    padding: 0 14px 0 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.02em;
    flex: none;
  }
  .brand img {
    width: 28px;
    height: 28px;
  }
  .sections {
    position: relative;
    min-width: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
  }
  .sections ul {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 4px;
  }
  .sections ul::-webkit-scrollbar {
    display: none;
  }
  .sections a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .sections a:hover,
  .sections a[aria-current='true'] {
    color: var(--ink);
  }
  .nav-bead {
    position: absolute;
    left: 0;
    bottom: 3px;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--pearl);
    box-shadow: 0 0 8px var(--pearl-glow);
    opacity: 0;
    transform: translateX(var(--x, 0px));
    transition:
      transform 420ms var(--spring),
      opacity 200ms var(--ease);
    pointer-events: none;
  }
  :global(html.docked) .nav-bead {
    opacity: 1;
  }
  .get {
    flex: none;
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--pill);
    color: var(--pill-ink);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  /* Over a night scene the capsules turn to night. */
  :global(html.under-night) .top {
    --paper: #0b1418;
    --ink: #eaf3f1;
    --ink-2: rgba(234, 243, 241, 0.72);
    --pill: #eaf3f1;
    --pill-ink: #0b1418;
    --pearl: #ff8a4c;
  }
  /* Every other page is one sheet of paper on the desk. */
  .page-sheet {
    padding: 72px 0 clamp(80px, 10vw, 140px);
    border-radius: 0 0 var(--sheet-r) var(--sheet-r);
  }
  @media (max-width: 900px) {
    .sections {
      display: none;
    }
  }
</style>
