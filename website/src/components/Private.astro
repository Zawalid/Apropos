---
/**
 * Private by construction: where each kind of data goes, then each macOS permission and why. Claims come from
 * docs/context-actions.md, docs/prediction.md, docs/destinations.md and the app's Privacy and data page.
 */
import { Image } from 'astro:assets';
import Window from './Window.astro';
import icon from '../assets/icon.png';

const reads = ['The menus of the app in front', 'Your selection', 'The page address and title', 'The folder and git branch', 'Selected files in Finder'];

// The files in ~/Library/Application Support/Apropos, from docs/data-layer.md and the docs it links.
const kept = [
  { file: 'usage.json', what: 'Which commands you run, pins, aliases' },
  { file: 'sequence.json', what: 'What you ran after what, for Usually next' },
  { file: 'settings.json', what: 'Your choices in Settings' },
  { file: 'send-folders.json', what: 'Folders you send files to' },
  { file: 'commands/', what: 'Your own commands, one file each' },
  { file: 'destinations/', what: 'Your own places to send to' },
];

const never = ['What you selected or sent', 'Web addresses and document names', 'Anything you typed while recording', 'Secure fields, which are never read'];

const permissions = [
  { name: 'Accessibility', when: 'Needed', why: 'Reads the menus of the app in front and presses the item you choose.' },
  { name: 'Automation of Finder', when: 'The first time you act on files', why: 'Asks Finder which files are selected. macOS asks you once.' },
  { name: 'Input Monitoring', when: 'Only to record', why: 'Lets a recording notice the menu items and shortcuts you use. Nothing is requested until you press Allow.' },
];
---
<section id="private" class="section private" aria-labelledby="private-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="private-title" class="claim">Private by construction.</h2>
      <p class="lede">
        No account, no analytics, no server. It makes no network connections; the update check is off until you turn it on.
      </p>
    </div>

    <div class="mac" data-mac>
      <p class="mac-label">Your Mac</p>
      <div class="flow">
        <div class="side reads">
          <h3>Read when you open the panel</h3>
          <ul>
            {reads.map((r, i) => <li style={`--i:${i}`}><span>{r}</span><i class="wire" aria-hidden="true"></i></li>)}
          </ul>
        </div>
        <div class="core">
          <Image src={icon} alt="" width={88} height={88} densities={[1, 2]} />
          <p class="core-name">Apropos</p>
          <p class="core-say">Held in memory while the list is open, then dropped</p>
        </div>
        <div class="side kept">
          <h3>Kept, as small files you can read</h3>
          <ul>
            {kept.map((k, i) => (
              <li style={`--i:${i}`}><i class="wire" aria-hidden="true"></i><code>{k.file}</code><span>{k.what}</span></li>
            ))}
          </ul>
          <p class="where">In ~/Library/Application Support/Apropos, each with Reveal and Forget.</p>
        </div>
      </div>
    </div>

    <div class="outside">
      <p class="out-label">Leaves your Mac</p>
      <p class="out-none">Nothing.</p>
      <ul class="out-never" aria-label="Never kept, never sent">
        {never.map((n) => <li>{n}</li>)}
      </ul>
    </div>

    <div class="lower">
      <div class="perms">
        <h3 class="perms-title">What it asks macOS for</h3>
        <dl>
          {permissions.map((p) => (
            <div>
              <dt>{p.name}</dt>
              <dd class="when">{p.when}</dd>
              <dd>{p.why}</dd>
            </div>
          ))}
        </dl>
        <p class="small">
          Settings, Privacy and data, on the right, scrolls with this page: what is kept with its size, Forget for each,
          Export all my data and Forget everything it learned. Recording asks for its two permissions on its own screen,
          only when you press Allow. <span class="early">Early</span>
        </p>
      </div>
      <div class="pages">
        <div class="scroller" data-scroll-page>
          <div class="scroll-inner"><Window id="privacy-page" width={600} /></div>
        </div>
        <div class="w-perm" data-drift="-0.08"><Window id="recording-permission" width={340} /></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Your Mac as a boundary: what is read flows into Apropos, what is kept flows out to files, nothing crosses out. */
  .mac {
    position: relative;
    padding: clamp(28px, 4vw, 56px);
    border-radius: 32px;
    background: var(--card);
    box-shadow:
      0 0 0 1px var(--line),
      0 50px 90px -60px rgba(6, 11, 14, 0.45);
  }
  .mac-label {
    position: absolute;
    top: 18px;
    left: 26px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(16px, 3vw, 40px);
    align-items: center;
    padding-top: 18px;
  }
  .side h3 {
    margin-bottom: 14px;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .side ul {
    display: grid;
    gap: 8px;
  }
  .reads li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
  }
  .reads li span,
  .kept li code {
    padding: 8px 14px;
    border-radius: 10px;
    background: var(--paper-2);
    font-size: 15px;
    white-space: nowrap;
  }
  .kept li {
    display: grid;
    grid-template-columns: 36px auto minmax(0, 1fr);
    gap: 12px;
    align-items: center;
  }
  .kept li .wire {
    order: -1;
  }
  .kept li code {
    font: 500 14px var(--mono);
  }
  .kept li > span {
    font-size: 14px;
    color: var(--ink-2);
  }
  .where {
    margin-top: 14px;
    font-size: 13px;
    color: var(--ink-3);
  }
  /* The wires: a line from each item toward the core, drawn when the box comes into view. */
  .wire {
    display: block;
    height: 2px;
    min-width: 24px;
    margin: 0 10px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--mint) 55%, transparent);
    transform-origin: left center;
  }
  .kept .wire {
    transform-origin: left center;
  }
  :global(html.js-motion) .mac .wire {
    transform: scaleX(0);
    transition: transform 420ms var(--ease);
    transition-delay: calc(var(--i) * 70ms);
  }
  :global(html.js-motion) .mac:global(.on) .wire {
    transform: none;
  }
  .core {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 180px;
    text-align: center;
  }
  .core img {
    width: 88px;
    height: 88px;
    filter: drop-shadow(0 18px 24px rgba(6, 11, 14, 0.35));
  }
  .core-name {
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .core-say {
    font-size: 13px;
    color: var(--ink-3);
  }
  .outside {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 8px 24px;
    align-items: baseline;
    margin-top: 16px;
    padding: 22px clamp(28px, 4vw, 56px);
    border-radius: 24px;
    border: 1.5px dashed var(--line-2);
  }
  .out-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .out-none {
    font-family: var(--display);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .out-never {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .out-never li::before {
    content: 'Never: ';
    color: var(--ink-3);
  }
  @media (max-width: 1100px) {
    .flow {
      grid-template-columns: 1fr;
    }
    .core {
      width: auto;
      order: -1;
      grid-auto-flow: column;
      justify-content: start;
      align-items: center;
      text-align: left;
    }
    .core img {
      width: 56px;
      height: 56px;
    }
    .wire {
      display: none;
    }
    .reads li span,
    .kept li code {
      white-space: normal;
    }
    .kept li {
      grid-template-columns: auto 1fr;
    }
    .outside {
      grid-template-columns: 1fr;
    }
  }
  .lower {
    margin-top: clamp(48px, 6vw, 88px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .perms {
    display: grid;
    gap: 22px;
  }
  .perms-title {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.022em;
  }
  .perms dl {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .perms dl div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .perms dt {
    font-weight: 600;
  }
  .when {
    font-size: 14px;
    color: var(--ink-3);
    text-align: right;
  }
  .perms dd:last-child {
    grid-column: 1 / -1;
    color: var(--ink-2);
  }
  @media (max-width: 900px) {
        .lower {
      grid-template-columns: 1fr;
    }
  }
  /* The real Privacy page, taller than any screen, scrolls inside its window as the site scrolls. */
  .pages {
    position: relative;
    padding: 0 0 12% 18%;
  }
  .scroller {
    position: relative;
    aspect-ratio: 0.82;
    overflow: hidden;
    border-radius: 18px;
    box-shadow:
      0 0 0 1px var(--line),
      0 30px 60px -28px rgba(6, 11, 14, 0.45);
  }
  .scroll-inner {
    transform: translateY(var(--scroll, 0px));
  }
  .scroll-inner :global(img) {
    filter: none;
  }
  .w-perm {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 44%;
    transform: translateY(var(--drift, 0px));
  }
  @media (max-width: 900px) {
    .pages {
      padding: 0 0 18% 12%;
    }
  }
</style>
