---
import { rows, tools } from '../data/compare';

interface Props {
  /** On the home page the table is a section; on /compare/ it is the page body. */
  heading?: boolean;
}
const { heading = true } = Astro.props;
---
<section id="compare" class="section compare" aria-labelledby={heading ? 'compare-title' : undefined}>
  <div class="wrap">
    {heading && (
      <div class="section-head">
        <h2 id="compare-title" class="claim">Keep your launcher.</h2>
        <p class="lede">
          Apropos does not launch apps, search files or keep your clipboard. Raycast, Alfred and Spotlight do that well,
          and Apropos sits next to any of them. It answers a narrower question: what can I do here, right now.
        </p>
      </div>
    )}
    <div class="table-wrap" tabindex="0" role="region" aria-label="Comparison of Apropos, Raycast, Spotlight, Alfred and the Help menu">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            {tools.map((t) => <th scope="col" class:list={{ us: t.id === 'apropos' }}>{t.short}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {tools.map((t) => {
                const cell = row.cells[t.id];
                return (
                  <td class:list={{ us: t.id === 'apropos' }}>
                    {cell.source ? <a href={cell.source} rel="noopener">{cell.text}</a> : cell.text}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small note">
      Checked on 20 October 2026 against each tool’s own pages and, for Spotlight’s menu search, a MacMost review. Each
      linked cell opens its source. More on <a href="/compare/raycast/">Raycast</a>, <a href="/compare/spotlight/">Spotlight</a>
      and <a href="/compare/alfred/">Alfred</a>.
    </p>
  </div>
</section>

<style>
  .table-wrap {
    overflow-x: auto;
    border-radius: var(--r-frame);
    box-shadow: 0 0 0 1px var(--line);
    background: var(--card);
  }
  table {
    width: 100%;
    min-width: 860px;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.4;
  }
  th,
  td {
    padding: 16px 18px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  thead th {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    padding-block: 18px 14px;
  }
  tbody th {
    font-weight: 600;
    width: 17%;
  }
  /* The row names stay in view while the table scrolls sideways on a phone. */
  tbody th,
  thead th:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--card);
  }
  @media (max-width: 760px) {
    tbody th {
      min-width: 128px;
      box-shadow: 1px 0 0 var(--line);
    }
  }
  td {
    color: var(--ink-2);
    width: 16.6%;
  }
  td a {
    color: inherit;
    text-decoration-color: var(--line-2);
  }
  td a:hover {
    color: var(--mint);
    text-decoration-color: currentColor;
  }
  .us {
    background: var(--paper-2);
    color: var(--ink);
  }
  .note {
    margin-top: 18px;
    max-width: 72ch;
  }
</style>
