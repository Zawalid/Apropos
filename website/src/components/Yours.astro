---
/**
 * Make your own: one real command file (the format of docs/user-commands.md, its own example) with the four ways to run
 * it beside it. Pointing at a way lights the line of the file it comes from. Then recording and keys for menu items as
 * two feature rows with their real windows, both tagged Early.
 */
import Window from './Window.astro';

const link = 'apropos://run?command=say&text=hello';

// The file, line by line. `for` ties a line to the way of running it that it enables.
const file: { t: string; for?: string }[] = [
  { t: '{' },
  { t: '  "command": {' },
  { t: '    "title": "Speak selection",' },
  { t: '    "requires": ["selectedText"],' },
  { t: '    "backend": { "type": "shell",' },
  { t: '      "executable": "/usr/bin/say", "stdin": "text" }' },
  { t: '  },' },
  { t: '  "aliases": ["say"],', for: 'alias' },
  { t: '  "hotkey": { "keyCode": 1,', for: 'key' },
  { t: '    "modifiers": ["control", "option"] },', for: 'key' },
  { t: '  "allowFromURL": true', for: 'link shortcuts' },
  { t: '}' },
];
---
<section id="yours" class="section yours" aria-labelledby="yours-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="yours-title" class="claim">Make your own commands.</h2>
      <p class="lede">
        A link, a Shortcut or a program becomes a row in the list. Write it once, then reach it four ways. It asks before
        its first run, and it can say what it needs, like selected text.
      </p>
    </div>

    <div class="anatomy" data-anatomy>
      <figure class="file">
        <figcaption class="file-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>commands/speak-selection.json</span>
        </figcaption>
        <pre tabindex="0" aria-label="The command file"><code>{file.map((l) => <span class="ln" data-for={l.for}>{l.t}{'\n'}</span>)}</code></pre>
      </figure>

      <ol class="ways">
        <li data-way="alias">
          <p class="w-demo" aria-hidden="true"><span class="typed">say</span><span class="pill-alias">say</span><span class="w-row">Speak selection</span></p>
          <h3>Type its alias</h3>
          <p>The alias puts it first, whatever else matches.</p>
        </li>
        <li data-way="key">
          <p class="w-demo" aria-hidden="true"><span class="cap">&#8963;</span><span class="cap">&#8997;</span><span class="cap">S</span></p>
          <h3>Press its key</h3>
          <p>From any app. A key that macOS, the panel or another command uses is flagged.</p>
        </li>
        <li data-way="link">
          <p class="w-demo w-link"><code>{link}</code><button class="copy" type="button" data-copy={link}>Copy</button></p>
          <h3>Open its link</h3>
          <p>From a Raycast quicklink, Alfred or a script, once you allow it from outside.</p>
        </li>
        <li data-way="shortcuts">
          <p class="w-demo" aria-hidden="true"><span class="sc">Run Apropos Command</span><span class="w-row">Speak selection</span></p>
          <h3>Use it in Shortcuts</h3>
          <p>The Run Apropos Command action lists the commands you allowed.</p>
        </li>
      </ol>
    </div>

    <div class="feature">
      <div class="f-text">
        <h3>Record it once <span class="early">Early</span></h3>
        <p>
          Choose Record and use the menus of any app, then stop with Control-Option-Command-R. The review lists every step
          in plain words with how sturdy it is, tries each one against the apps without pressing anything, and saves it as
          a command. Typed text is never recorded.
        </p>
      </div>
      <div class="f-win" data-drift="-0.04"><Window id="recording-review" width={560} /></div>
    </div>

    <div class="feature flip">
      <div class="f-text">
        <h3>Keys for any menu item <span class="early">Early</span></h3>
        <p>
          Command-K on a menu item gives it an alias and a shortcut of its own. One key can serve items in different apps,
          since it runs the item of the app in front.
        </p>
      </div>
      <div class="f-win" data-drift="-0.04"><Window id="alias-popover" width={640} /></div>
    </div>
  </div>
</section>

<style>
  .anatomy {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 16px;
    align-items: stretch;
  }
  .file {
    display: grid;
    grid-template-rows: auto 1fr;
    margin: 0;
    border-radius: 22px;
    background: #0b1418;
    color: #c9d6d3;
    box-shadow: 0 40px 80px -44px rgba(6, 11, 14, 0.55);
    overflow: hidden;
  }
  @media (prefers-color-scheme: dark) {
    .file {
      background: #060b0e;
      box-shadow: 0 0 0 1px var(--line);
    }
  }
  .file-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    font: 500 13px var(--mono);
    color: rgba(234, 243, 241, 0.66);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
  }
  .file pre {
    display: grid;
    align-content: center;
    margin: 0;
    padding: 22px 0 26px;
    overflow-x: auto;
    font: 500 15px/1.95 var(--mono);
  }
  .ln {
    display: block;
    padding: 0 22px;
    white-space: pre;
    transition:
      background-color 160ms var(--ease),
      color 160ms var(--ease);
  }
  .ln[data-for] {
    color: #eaf3f1;
  }
  .ln:global(.lit) {
    background: rgba(140, 242, 204, 0.12);
    color: #8cf2cc;
  }

  .ways {
    display: grid;
    gap: 12px;
  }
  .ways li {
    display: grid;
    gap: 6px;
    padding: 18px 22px;
    border-radius: 18px;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--line);
    transition: box-shadow 160ms var(--ease);
  }
  .ways li:hover,
  .ways li:global(.lit) {
    box-shadow:
      0 0 0 1px var(--line-2),
      0 18px 40px -26px rgba(6, 11, 14, 0.35);
  }
  .ways h3 {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .ways p:not(.w-demo) {
    color: var(--ink-2);
    font-size: 15px;
  }
  .w-demo {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    margin-bottom: 4px;
    font-size: 15px;
  }
  .typed {
    font-weight: 600;
  }
  .typed::after {
    content: '';
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin: 0 10px 0 2px;
    vertical-align: -0.2em;
    background: var(--mint);
  }
  .pill-alias {
    padding: 1px 8px;
    border-radius: 6px;
    background: var(--mint-wash);
    font-size: 13px;
    font-weight: 700;
  }
  .w-row {
    font-weight: 600;
  }
  .sc {
    padding: 4px 10px;
    border-radius: 8px;
    background: var(--paper-2);
    font-size: 13px;
    font-weight: 600;
  }
  .cap {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--key);
    color: var(--key-ink);
    box-shadow:
      0 0 0 1px var(--line-2),
      0 3px 0 var(--key-edge);
    font-size: 15px;
    font-weight: 500;
    transition:
      transform 90ms var(--ease),
      box-shadow 90ms var(--ease);
  }
  li[data-way='key']:hover .cap,
  li[data-way='key']:global(.lit) .cap {
    transform: translateY(2px);
    box-shadow:
      0 0 0 1px var(--line-2),
      0 1px 0 var(--key-edge);
  }
  .w-link {
    justify-content: space-between;
    padding: 6px 6px 6px 12px;
    border-radius: 10px;
    background: var(--paper-2);
  }
  .w-link code {
    min-width: 0;
    overflow-wrap: anywhere;
    font: 500 13px var(--mono);
  }
  .copy {
    flex: none;
    min-height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--line-2);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  /* Recording and menu item keys: the real window large beside the words, alternating sides. */
  .feature {
    margin-top: clamp(80px, 10vw, 140px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .feature.flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  .feature.flip .f-text {
    order: 2;
  }
  .f-text {
    display: grid;
    gap: 14px;
  }
  .f-text h3 {
    font-family: var(--display);
    font-size: clamp(30px, 3.2vw, 44px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .f-text p {
    color: var(--ink-2);
    max-width: 42ch;
  }
  .f-win {
    justify-self: center;
    width: min(100%, 640px);
    transform: translateY(var(--drift, 0px));
  }
  @media (max-width: 600px) {
    .file pre {
      font-size: 11.5px;
      line-height: 1.8;
    }
    .ln {
      padding: 0 14px;
    }
  }
  @media (max-width: 900px) {
    .anatomy,
    .feature,
    .feature.flip {
      grid-template-columns: 1fr;
    }
    .feature.flip .f-text {
      order: 0;
    }
  }
</style>
