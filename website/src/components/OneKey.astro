---
/**
 * One key, a different list per app: a capture per app behind a dock of real app icons. The typed examples name real
 * menu items; when apps.json has the app, the build checks the item exists and warns if it does not.
 */
import { Image } from 'astro:assets';
import Shot from './Shot.astro';
import { fmt, hasCommand, iconFor, measured } from '../data/apps';
import type { SlotId } from '../data/shots';

interface Tab {
  app: string;
  slot: SlotId;
  typed: string;
  /** The command title with the matched letters wrapped as [x]. */
  hit: string;
  note: string;
}

const tabs: Tab[] = [
  { app: 'Finder', slot: 'finder', typed: 'nf', hit: '[N]ew [F]older', note: 'First letters of each word find the item.' },
  { app: 'Safari', slot: 'safari', typed: 'sidebra', hit: 'Show [Sidebar]', note: 'Two letters swapped still find it.' },
  { app: 'Mail', slot: 'mail', typed: 'ra', hit: '[R]eply [A]ll', note: 'The shortcut sits next to the item, so you learn it on the way.' },
  { app: 'Notes', slot: 'notes', typed: 'check', hit: '[Check]list', note: 'A word from the middle of a menu works too.' },
  { app: 'Xcode', slot: 'xcode', typed: 'clean', hit: '[Clean] Build Folder', note: 'Deep items come up as fast as the top ones.' },
];

const titleOf = (t: Tab) => t.hit.replace(/[[\]]/g, '');
for (const t of tabs) {
  if (hasCommand(t.app, titleOf(t)) === false) console.warn(`[one key] ${t.app} has no menu item named "${titleOf(t)}" in apps.json`);
}
/** The shortcut as measured, never typed in by hand. */
const keysOf = (t: Tab) =>
  measured(t.app)?.commands.find((c) => c.title.toLowerCase() === titleOf(t).toLowerCase())?.shortcut ?? null;

const marked = (hit: string) => hit.replace(/\[([^\]]+)\]/g, '<mark>$1</mark>');
---
<section id="onekey" class="section onekey" aria-labelledby="onekey-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="onekey-title" class="claim">One key. A different list in every app.</h2>
      <p class="lede">
        The list is built from the menus of the app in front, the moment you open it. Nothing to set up per app, and
        nothing to remember: if the app can do it, it is in the list with its shortcut.
      </p>
    </div>

    <div class="stage" data-tabs>
      <div class="panels">
        {tabs.map((t, i) => {
          const m = measured(t.app);
          return (
            <div class="panel" id={`onekey-${t.slot}`} role="tabpanel" aria-labelledby={`onekey-tab-${t.slot}`} hidden={i !== 0} data-panel>
              <Shot id={t.slot} ratio={1.6} sizes="(min-width: 1240px) 1240px, 100vw" />
              <div class="caption">
                <p class="typed">
                  <span class="label">{t.app}, type</span>
                  <span class="q">{t.typed}</span>
                  <span class="arrow" aria-hidden="true"></span>
                  <span class="hit" set:html={marked(t.hit)} />
                  {keysOf(t) && <kbd class="kbd keys">{keysOf(t)}</kbd>}
                </p>
                <p class="small">
                  {t.note}
                  {m && <> {t.app} lists {fmt(m.total)} commands here.</>}
                </p>
              </div>
            </div>
          );
        })}
      </div>

      <div class="dock" role="tablist" aria-label="Apps">
        {tabs.map((t, i) => {
          const icon = iconFor(t.app);
          return (
            <button
              class="dock-item"
              type="button"
              role="tab"
              id={`onekey-tab-${t.slot}`}
              aria-controls={`onekey-${t.slot}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-tab
            >
              {icon && <Image src={icon} alt="" width={52} height={52} densities={[1, 2]} />}
              <span>{t.app}</span>
            </button>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    display: grid;
    gap: 22px;
  }
  .panels {
    display: grid;
  }
  .panel {
    grid-area: 1 / 1;
  }
  .panel[hidden] {
    display: block;
    visibility: hidden;
    opacity: 0;
  }
  .panel {
    transition: opacity 200ms var(--ease);
  }
  .caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 24px;
    margin-top: 20px;
  }
  .typed {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 19px;
  }
  .label {
    color: var(--ink-3);
  }
  .q {
    padding: 2px 10px;
    border-radius: var(--r-control);
    background: var(--paper-2);
    box-shadow: 0 0 0 1px var(--line);
    font-weight: 500;
  }
  .arrow {
    width: 22px;
    height: 1px;
    background: var(--ink-3);
  }
  .hit {
    font-weight: 600;
  }
  .keys {
    font-size: 15px;
  }
  .dock {
    justify-self: center;
    display: flex;
    gap: 6px;
    padding: 8px;
    border-radius: 22px;
    background: var(--card);
    box-shadow:
      0 0 0 1px var(--line),
      0 18px 40px -24px rgba(0, 0, 0, 0.35);
    max-width: 100%;
    overflow-x: auto;
  }
  .dock-item {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 6px 10px 8px;
    border: 0;
    border-radius: 14px;
    background: none;
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .dock-item img {
    width: 52px;
    height: 52px;
    transition: transform 200ms var(--ease);
  }
  .dock-item:hover img {
    transform: translateY(-3px);
  }
  .dock-item[aria-selected='true'] {
    color: var(--ink);
  }
  .dock-item[aria-selected='true']::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--pearl);
    box-shadow: 0 0 8px var(--pearl-glow);
  }
  @media (max-width: 560px) {
    .dock-item {
      padding: 6px 4px 8px;
    }
    .dock-item img {
      width: 44px;
      height: 44px;
    }
    .typed {
      font-size: 17px;
    }
  }
</style>
