---
/**
 * One picture of the real app, light and dark. An empty slot is a neutral placeholder that says which capture it waits
 * for (see src/data/shots.ts). Captures already include their wallpaper, so the frame only rounds and lifts them.
 */
import { getImage } from 'astro:assets';
import { shot, type SlotId } from '../data/shots';

interface Props {
  id: SlotId;
  /** Width over height, used for the placeholder and to reserve space. */
  ratio?: number;
  sizes?: string;
  eager?: boolean;
  class?: string;
  /**
   * How far to crop in toward the middle, where the panel sits in every capture: on wide screens, and below 700 px.
   * The wallpaper around the panel is art direction on a big frame and wasted pixels on a phone.
   */
  zoom?: number;
  zoomSmall?: number;
}

const { id, ratio = 1.45, sizes = '(min-width: 1240px) 1100px, 100vw', eager = false, class: className, zoom = 1, zoomSmall = 1.6 } = Astro.props;
const s = shot(id);
const widths = [640, 960, 1400, 2000];

async function srcset(image: NonNullable<typeof s.light>) {
  const usable = widths.filter((w) => w <= image.width);
  const list = usable.length ? usable : [image.width];
  const out = await Promise.all(list.map((w) => getImage({ src: image, width: w, format: 'webp', quality: 82 })));
  return { srcset: out.map((o, i) => `${o.src} ${list[i]}w`).join(', '), src: out[out.length - 1].src };
}

const light = s.light ? await srcset(s.light) : null;
const dark = s.dark && s.dark !== s.light ? await srcset(s.dark) : null;
const w = s.light?.width ?? 1400;
const h = s.light ? s.light.height : Math.round(1400 / ratio);
---
<figure class:list={['shot', className, { empty: !s.filled }]} style={`--ratio:${s.light ? s.light.width / s.light.height : ratio};--zoom:${zoom};--zoom-sm:${zoomSmall}`} data-slot={id}>
  {light ? (
    <picture>
      {dark && <source media="(prefers-color-scheme: dark)" srcset={dark.srcset} sizes={sizes} />}
      <img src={light.src} srcset={light.srcset} sizes={sizes} width={w} height={h} alt={s.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
    </picture>
  ) : (
    <div class="hold" role="img" aria-label={s.alt}>
      <span>Capture coming: {s.want}</span>
    </div>
  )}
</figure>

<style>
  .shot {
    position: relative;
    aspect-ratio: var(--ratio);
    border-radius: var(--r-frame);
    overflow: hidden;
    background: var(--paper-2);
    box-shadow: var(--shadow-frame);
    isolation: isolate;
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--zoom, 1));
  }
  @media (max-width: 700px) {
    .shot img {
      transform: scale(var(--zoom-sm, 1.6));
    }
  }
  .hold {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end start;
    padding: 18px 20px;
    background: var(--paper-2);
    outline: 1px solid var(--line);
    outline-offset: -1px;
    border-radius: inherit;
  }
  .hold span {
    font-size: 13px;
    color: var(--ink-3);
    max-width: 30ch;
  }
</style>
