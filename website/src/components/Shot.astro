---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** File name under src/assets/shots, without the -dark or -light suffix and the extension. */
  name: string;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { name, alt, sizes = '(max-width: 700px) 94vw, 1000px', loading = 'lazy', class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true });
const pick = (mode: 'dark' | 'light') => {
  const file = files[`../assets/shots/${name}-${mode}.png`];
  if (!file) throw new Error(`Missing image ${name}-${mode}.png in src/assets/shots`);
  return file.default;
};
const widths = [720, 1080, 1440];
const build = async (src: ImageMetadata) => {
  const set = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp', quality: 90 })));
  return { src: set[1]?.src ?? '', srcset: set.map((image, i) => `${image.src} ${widths[i]}w`).join(', ') };
};
const dark = pick('dark');
const [lightSet, darkSet] = await Promise.all([build(pick('light')), build(dark)]);
// The render has its own rounded corners; the frame matches them so the shadow follows the shape.
const radius = name.startsWith('palette') ? 52 : 44;
const frameRadius = `${((radius / dark.width) * 100).toFixed(3)}% / ${((radius / dark.height) * 100).toFixed(3)}%`;
---
<div class:list={['shot', className]} style={`border-radius: ${frameRadius}`}>
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset={darkSet.srcset} sizes={sizes} />
    <img
      src={lightSet.src}
      srcset={lightSet.srcset}
      sizes={sizes}
      alt={alt}
      width={dark.width}
      height={dark.height}
      loading={loading}
      decoding="async"
      fetchpriority={loading === 'eager' ? 'high' : undefined}
    />
  </picture>
  <slot />
</div>
