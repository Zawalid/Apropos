---
import { links, site, version } from '../data/site';
import { faq } from '../data/faq';
import Window from './Window.astro';
import ring from '../assets/icon.png';
import paper from '../assets/wallpaper-paper.webp';
import night from '../assets/wallpaper-night.webp';
import { Image } from 'astro:assets';
---
<section id="install" class="section install" aria-labelledby="install-title">
  <div class="wrap">
    <div class="get">
      <div class="get-text">
        <h2 id="install-title" class="claim">From download to the first Option-Space.</h2>
        <p class="small">Version {version}. macOS {site.minimumMacOS} or later. <a href={links.changelog}>What changed</a></p>
      </div>
      <a class="pill big-pill" href={links.download}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5v9m0 0L4.5 7M8 10.5 11.5 7M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Download for Mac
      </a>
    </div>

    <div class="stepper" data-stepper>
      <div class="step-tabs" role="tablist" aria-label="Install steps">
        <button type="button" role="tab" id="step-tab-0" aria-controls="step-0" aria-selected="true" tabindex="0" data-tab>
          <span class="n">1</span><span class="timer" aria-hidden="true"></span>
          <span class="t"><strong>Open the download</strong>Move Apropos to Applications and open it. It lives in the menu bar, with no Dock icon.</span>
        </button>
        <button type="button" role="tab" id="step-tab-1" aria-controls="step-1" aria-selected="false" tabindex="-1" data-tab>
          <span class="n">2</span><span class="timer" aria-hidden="true"></span>
          <span class="t"><strong>Allow Accessibility</strong>The welcome guide says why, opens the right page of System Settings, and notices the change without a restart.</span>
        </button>
        <button type="button" role="tab" id="step-tab-2" aria-controls="step-2" aria-selected="false" tabindex="-1" data-tab>
          <span class="n">3</span><span class="timer" aria-hidden="true"></span>
          <span class="t"><strong>Press Option-Space</strong>In any app. Type a few letters of what you want, press Return. Escape closes it.</span>
        </button>
      </div>
      <div class="screen" aria-label="A Mac screen">
        <picture class="wallpaper" aria-hidden="true">
          <source media="(prefers-color-scheme: dark)" srcset={night.src} />
          <img src={paper.src} alt="" width={paper.width} height={paper.height} loading="lazy" decoding="async" />
        </picture>
        <div class="menubar" aria-hidden="true">
          <strong>Finder</strong><span>File</span><span>Edit</span><span>View</span><span class="mb-more">Go</span><span class="mb-more">Window</span>
          <span class="mb-gap"></span><Image src={ring} alt="" width={16} height={16} densities={[1, 2]} class="mb-ring" /><span class="mb-clock">Tue 9:41</span>
        </div>
        <div class="step-panel p-bar" id="step-0" role="tabpanel" aria-labelledby="step-tab-0" data-panel>
          <Window id="menubar-popover" width={300} />
        </div>
        <div class="step-panel p-mid" id="step-1" role="tabpanel" aria-labelledby="step-tab-1" hidden data-panel>
          <Window id="onboarding-permission" width={560} />
        </div>
        <div class="step-panel p-mid p-panel" id="step-2" role="tabpanel" aria-labelledby="step-tab-2" hidden data-panel>
          <Window id="hero-nf" width={520} />
        </div>
      </div>
    </div>

    <div class="faq" data-faq>
      <div class="faq-head">
        <h2 class="faq-title">Questions</h2>
        <label class="search">
          <span class="visually-hidden">Search the questions</span>
          <input type="search" placeholder="Search the questions" autocomplete="off" data-faq-search />
        </label>
      </div>
      <div class="qs">
        {faq.map((q) => (
          <details data-q>
            <summary>{q.q}</summary>
            <div class="a" set:html={q.a} />
          </details>
        ))}
      </div>
      <p class="small none" data-faq-none hidden>No question matches. <a href={links.issues}>Ask on GitHub</a></p>
    </div>
  </div>
</section>

<style>
  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 28px 40px;
    padding-bottom: clamp(36px, 4vw, 56px);
    border-bottom: 1px solid var(--line);
  }
  .get-text {
    display: grid;
    gap: 18px;
  }
  .big-pill {
    min-height: 56px;
    padding: 0 30px;
    font-size: 17px;
  }

  .stepper {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-top: clamp(32px, 4vw, 56px);
  }
  .step-tabs {
    display: grid;
    gap: 8px;
  }
  .step-tabs button {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 14px;
    padding: 16px 18px;
    border: 0;
    border-radius: var(--r-box);
    background: none;
    text-align: left;
    cursor: pointer;
    color: var(--ink-2);
    transition: background-color 200ms var(--ease);
  }
  .step-tabs button {
    position: relative;
    overflow: hidden;
  }
  /* The step that moves on by itself shows how long until the next one. */
  .timer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--mint);
    transform: scaleX(0);
    transform-origin: left center;
  }
  :global(html.motion-on) .stepper:not([data-touched]) button[aria-selected='true'] .timer {
    animation: timer 3200ms linear both;
  }
  @keyframes timer {
    to {
      transform: scaleX(1);
    }
  }
  .step-tabs button[aria-selected='true'] {
    background: var(--card);
    box-shadow: 0 0 0 1px var(--line);
    color: var(--ink-2);
  }
  .n {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  button[aria-selected='true'] .n {
    background: var(--pill);
    color: var(--pill-ink);
    box-shadow: none;
  }
  .t {
    display: grid;
    gap: 4px;
    font-size: 15px;
    line-height: 1.45;
  }
  .t strong {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-14px) scale(0.94);
    }
  }
  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @media (max-width: 600px) {
    .mb-clock,
    .menubar span:nth-of-type(n + 3) {
      display: none;
    }
    }
  /* A small Mac screen: the real capture wallpaper, a drawn menu bar, and the real window of each step on it. */
  .screen {
    position: relative;
    aspect-ratio: 16 / 10.4;
    border-radius: 18px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--line-2),
      0 50px 90px -50px rgba(6, 11, 14, 0.55);
    isolation: isolate;
  }
  .wallpaper,
  .wallpaper img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .menubar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 16px;
    height: 26px;
    padding: 0 14px;
    background: color-mix(in srgb, var(--paper) 62%, transparent);
    font-size: 12px;
    color: var(--ink);
  }
  .mb-gap {
    flex: 1;
  }
  .menubar :global(.mb-ring) {
    width: 15px;
    height: 15px;
    border-radius: 4px;
  }
  .mb-clock {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .step-panel {
    position: absolute;
    z-index: 1;
    animation: step-in 260ms var(--ease);
  }
  .step-panel[hidden] {
    display: none;
  }
  /* The popover hangs from the Apropos icon: the icon sits right above the middle of the popover, where its notch is. */
  .p-bar {
    transform-origin: 50% 0;
    animation-name: drop;
    animation-duration: 420ms;
    animation-timing-function: cubic-bezier(0.34, 1.4, 0.64, 1);
    top: 30px;
    right: 12px;
    width: 36%;
  }
  .menubar :global(.mb-ring) {
    position: absolute;
    right: calc(12px + 18% - 7.5px);
    top: 5.5px;
  }
  .p-mid {
    left: 50%;
    top: 54%;
    width: 78%;
    translate: -50% -50%;
  }
  .p-panel {
    top: 47%;
    width: 72%;
  }
  .faq {
    margin-top: clamp(96px, 11vw, 160px);
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 24px clamp(24px, 5vw, 80px);
    align-items: start;
  }
  .faq-head {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 22px;
  }
  .faq-title {
    font-family: var(--display);
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .search input {
    width: 100%;
    height: 46px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--line-2);
    color: var(--ink);
    font: inherit;
    font-size: 16px;
  }
  .search input::placeholder {
    color: var(--ink-3);
  }
  .qs {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 1.6px solid var(--ink-2);
    border-bottom: 1.6px solid var(--ink-2);
    transform: translateY(-3px) rotate(45deg);
    transition: transform 200ms var(--ease);
  }
  details[open] summary::after {
    transform: translateY(2px) rotate(-135deg);
  }
  /* The chevron turns back as soon as an answer starts to close, not when it has finished. */
  details[data-closing='1'] summary::after {
    transform: translateY(-3px) rotate(45deg);
  }
  .a {
    padding: 0 0 22px;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .a :global(p + p) {
    margin-top: 10px;
  }
  .none {
    grid-column: 2;
  }
  @media (max-width: 860px) {
    .stepper,
    .faq {
      grid-template-columns: 1fr;
    }
    .faq-head {
      position: static;
    }
    .none {
      grid-column: 1;
    }
  }
  @media (max-width: 600px) {
    .mb-more,
    .mb-clock {
      display: none;
    }
    .p-bar {
      right: 8px;
      width: 52%;
    }
    .menubar :global(.mb-ring) {
      right: calc(8px + 26% - 7.5px);
    }
    .p-mid,
    .p-panel {
      width: 92%;
    }
  }
</style>
