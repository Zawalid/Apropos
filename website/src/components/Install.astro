---
import { links, site, version } from '../data/site';
import { faq } from '../data/faq';
import Shot from './Shot.astro';
---
<section id="install" class="section install" aria-labelledby="install-title">
  <div class="wrap">
    <div class="get">
      <div class="get-text">
        <h2 id="install-title" class="claim">From download to the first Option-Space.</h2>
        <p class="small">Version {version}. macOS {site.minimumMacOS} or later. <a href={links.changelog}>What changed</a></p>
      </div>
      <a class="pill big-pill" href={links.download}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5v9m0 0L4.5 7M8 10.5 11.5 7M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Download for Mac
      </a>
    </div>

    <div class="first">
    <ol class="steps">
      <li>
        <h3>Open the download</h3>
        <p>Move Apropos to Applications and open it. It lives in the menu bar, with no Dock icon.</p>
      </li>
      <li>
        <h3>Allow Accessibility</h3>
        <p>The welcome screen says why and opens the right page of System Settings. Apropos notices the change without a restart.</p>
      </li>
      <li>
        <h3>Press Option-Space</h3>
        <p>In any app. Type a few letters of what you want, press Return. Escape closes it.</p>
      </li>
    </ol>
    <figure class="bar-pic">
      <Shot id="menubar-popover" ratio={1.25} zoom={1.25} zoomSmall={1.4} sizes="(max-width: 700px) 140vw, (min-width: 1000px) 820px, 125vw" />
      <figcaption class="small">The menu bar shows the app in front and what is read from it, pauses context or learning for an hour, and lists your recent commands.</figcaption>
    </figure>
    </div>

    <div class="faq" data-faq>
      <div class="faq-head">
        <h2 class="faq-title">Questions</h2>
        <label class="search">
          <span class="visually-hidden">Search the questions</span>
          <input type="search" placeholder="Search the questions" autocomplete="off" data-faq-search />
        </label>
      </div>
      <div class="qs">
        {faq.map((q) => (
          <details data-q>
            <summary>{q.q}</summary>
            <div class="a" set:html={q.a} />
          </details>
        ))}
      </div>
      <p class="small none" data-faq-none hidden>No question matches. <a href={links.issues}>Ask on GitHub</a></p>
    </div>
  </div>
</section>

<style>
  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 28px 40px;
    padding-bottom: clamp(36px, 4vw, 56px);
    border-bottom: 1px solid var(--line);
  }
  .get-text {
    display: grid;
    gap: 18px;
  }
  .big-pill {
    min-height: 56px;
    padding: 0 30px;
    font-size: 17px;
  }
  .first {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-top: clamp(32px, 4vw, 56px);
  }
  .steps {
    display: grid;
    gap: 28px;
    counter-reset: step;
  }
  .bar-pic {
    display: grid;
    gap: 12px;
  }
  .steps li {
    display: grid;
    align-content: start;
    gap: 8px;
    counter-increment: step;
  }
  .steps h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.022em;
  }
  .steps h3::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: 14px;
    font-weight: 600;
  }
  .steps p {
    color: var(--ink-2);
  }

  .faq {
    margin-top: clamp(96px, 11vw, 160px);
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 24px clamp(24px, 5vw, 80px);
    align-items: start;
  }
  .faq-head {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 22px;
  }
  .faq-title {
    font-family: var(--display);
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .search input {
    width: 100%;
    height: 46px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--line-2);
    color: var(--ink);
    font: inherit;
    font-size: 16px;
  }
  .search input::placeholder {
    color: var(--ink-3);
  }
  .qs {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 1.6px solid var(--ink-2);
    border-bottom: 1.6px solid var(--ink-2);
    transform: translateY(-3px) rotate(45deg);
    transition: transform 200ms var(--ease);
  }
  details[open] summary::after {
    transform: translateY(2px) rotate(-135deg);
  }
  .a {
    padding: 0 0 22px;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .a :global(p + p) {
    margin-top: 10px;
  }
  .none {
    grid-column: 2;
  }
  @media (max-width: 860px) {
    .first,
    .faq {
      grid-template-columns: 1fr;
    }
    .faq-head {
      position: static;
    }
    .none {
      grid-column: 1;
    }
  }
</style>
