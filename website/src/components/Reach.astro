---
/**
 * Reach other apps: Send to and sequences, told as one flow. The steps scroll; the line with the pearl and the capture
 * stay in view and follow the step you are reading.
 */
import { Image } from 'astro:assets';
import Shot from './Shot.astro';
import { iconFor } from '../data/apps';

const steps = [
  { title: 'Start with the selection in Safari.', body: 'Command-K on any row adds it as a step: here, Copy from Safari’s own Edit menu. The draft shows at the top of the list.' },
  { title: 'Add UPPERCASE.', body: 'Each step reads the result of the step before it, so the copied text arrives here.' },
  { title: 'Add Send to Notes.', body: 'Notes, Reminders, Things, Obsidian, Bear, a Mail draft or the Share menu. Notes gets the capitals, not the original.' },
  { title: 'Run it, or keep it.', body: 'Run the draft once, or save it as your own command with a name, an alias and a key.' },
];

const destinations = [
  { name: 'Notes' },
  { name: 'Reminders' },
  { name: 'Things' },
  { name: 'Obsidian' },
  { name: 'Bear' },
  { name: 'A Mail draft', note: 'It never sends.' },
  { name: 'A folder', note: 'Copy or move files there.' },
  { name: 'The Share menu' },
];
const chain = [iconFor('Safari'), iconFor('Notes')];
---
<section id="reach" class="section reach" aria-labelledby="reach-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="reach-title" class="claim">Send it where it belongs.</h2>
      <p class="lede">
        A selection, a page or a few files can go to another app without leaving the keyboard. Steps from different apps
        chain into one command.
      </p>
    </div>

    <div class="story" data-story>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class:list={['step', { on: i === 0 }]} data-step={i}>
            <span class="step-n num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>

      <div class="sticky">
        <div class="line" aria-hidden="true">
          <span class="node">{chain[0] && <Image src={chain[0]} alt="" width={44} height={44} densities={[1, 2]} />}</span>
          <span class="node word">UPPERCASE</span>
          <span class="node">{chain[1] && <Image src={chain[1]} alt="" width={44} height={44} densities={[1, 2]} />}</span>
          <span class="track"><span class="bead travel" data-line-bead></span></span>
        </div>
        <div class="views">
          <div class="view on" data-view="0"><Shot id="sequence-draft" ratio={1.25} zoom={1.2} zoomSmall={1.45} sizes="(max-width: 700px) 145vw, (min-width: 1000px) 840px, 120vw" /></div>
          <div class="view" data-view="1"><Shot id="send-list" ratio={1.25} zoom={1.2} zoomSmall={1.45} sizes="(max-width: 700px) 145vw, (min-width: 1000px) 840px, 120vw" /></div>
        </div>
        <p class="small cap">
          Step icons in the draft are new and not yet checked on a real Mac. <span class="early">Early</span>
        </p>
      </div>
    </div>

    <div class="dest">
      <div class="dest-text">
      <h3 class="dest-title">Built in places to send to</h3>
      <ul class="dest-list">
        {destinations.map((d) => {
          return (
            <li>
              <span class="dest-name">{d.name}</span>
              {d.note && <span class="dest-note">{d.note}</span>}
            </li>
          );
        })}
      </ul>
      <p class="small">
        Each shows only when its app is installed. Anything that leaves a trace, a draft, a move, a share, waits for a second
        Return with a one-line preview. Apropos remembers where you sent things, never what you sent.
      </p>
      </div>
      <Shot id="send-confirm" ratio={4 / 3} zoom={1.3} zoomSmall={1.4} sizes="(max-width: 900px) 140vw, 640px" />
    </div>
  </div>
</section>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 5vw, 80px);
  }
  .steps {
    display: grid;
  }
  .step {
    min-height: 62vh;
    display: grid;
    align-content: center;
    gap: 10px;
    transition: opacity 240ms var(--ease);
  }
  :global(.reading) .step:not(.on) {
    opacity: 0.4;
  }
  .step:first-child {
    min-height: 40vh;
    align-content: start;
  }
  .step-n {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: 14px;
    font-weight: 600;
  }
  .step h3 {
    font-family: var(--display);
    font-size: clamp(26px, 2.6vw, 36px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .step p {
    color: var(--ink-2);
    max-width: 34ch;
  }
  .sticky {
    position: sticky;
    top: 96px;
    align-self: start;
    display: grid;
    gap: 20px;
  }
  .line {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px;
    height: 56px;
  }
  .node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    background: var(--paper);
    padding: 0 8px;
  }
  .node img {
    width: 44px;
    height: 44px;
  }
  .word {
    height: 32px;
    padding: 0 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: 13px;
    font-weight: 700;
  }
  .track {
    position: absolute;
    left: 30px;
    right: 30px;
    top: 50%;
    height: 2px;
    background: var(--line-2);
    border-radius: 2px;
  }
  .travel {
    position: absolute;
    left: 0;
    top: 26px;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    transform: translateX(var(--x, 0px));
    transition: transform 420ms var(--spring);
    z-index: 2;
  }
  .views {
    display: grid;
  }
  .view {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 240ms var(--ease);
  }
  .view.on {
    opacity: 1;
  }
  .cap {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .dest {
    margin-top: clamp(64px, 8vw, 112px);
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 24px clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .dest-text {
    display: grid;
    gap: 24px;
  }
  .dest-title {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .dest-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .dest-list li {
    display: grid;
    align-content: start;
    gap: 2px;
    padding: 16px 12px 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .dest-name {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .dest-note {
    font-size: 14px;
    color: var(--ink-3);
  }
  .dest .small {
    max-width: 62ch;
  }

  @media (max-width: 900px) {
    .story {
      grid-template-columns: 1fr;
    }
    .sticky {
      position: relative;
      top: 0;
      order: -1;
    }
    .step,
    .step:first-child,
    :global(.reading) .step:not(.on) {
      min-height: 0;
      padding-block: 18px;
      opacity: 1;
    }
    .dest {
      grid-template-columns: 1fr;
    }
    .dest-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
