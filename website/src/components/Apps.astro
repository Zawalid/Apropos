---
/**
 * Works with your apps: a moving wall of real app icons, then an explorer of the measured apps. Without apps.json the
 * explorer is left out and the wall stays, since every icon is an app the list reads through its menu bar.
 */
import { Image } from 'astro:assets';
import { fmt, iconFor, measurement, wallApps, type MeasuredApp } from '../data/apps';
import Shot from './Shot.astro';
import type { SlotId } from '../data/shots';

// Real panels over real apps (stage captures; the menus are each app's real menu bar, the rest is sample data).
const gallery: { slot: SlotId; app: string }[] = [
  ['music', 'Music'], ['calendar', 'Calendar'], ['photos', 'Photos'], ['maps', 'Maps'], ['preview', 'Preview'],
  ['reminders', 'Reminders'], ['terminal', 'Terminal'], ['textedit', 'TextEdit'], ['systemsettings', 'System Settings'],
  ['finder', 'Finder'], ['mail', 'Mail'], ['notes', 'Notes'], ['xcode', 'Xcode'],
].map(([k, app]) => ({ slot: `app-${k}` as SlotId, app }));

const half = Math.ceil(wallApps.length / 2);
const rows = [wallApps.slice(0, half), wallApps.slice(half)];
const apps = measurement?.apps ?? [];

function sample(app: MeasuredApp) {
  const picked: MeasuredApp['commands'] = [];
  const menus = new Set<string>();
  for (const c of app.commands) {
    const top = c.path[0] ?? '';
    if (!c.shortcut || menus.has(top) || c.title.length > 32) continue;
    menus.add(top);
    picked.push(c);
    if (picked.length === 8) break;
  }
  return picked;
}

function topMenus(app: MeasuredApp) {
  return Object.entries(app.menus)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 6);
}
---
<section id="apps" class="section apps" aria-labelledby="apps-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="apps-title" class="claim">Works in the apps you already have.</h2>
      <p class="lede">
        If an app has a menu bar, Apropos reads it. No plugin per app, no waiting for anyone to add support.
      </p>
    </div>
  </div>

  <div class="marquee">
    {rows.map((row, r) => (
      <div class:list={['row', { reverse: r === 1 }]}>
        <ul class="belt">
          {[...row, ...row].map((name, i) => {
            const icon = iconFor(name);
            return (
              <li aria-hidden={i >= row.length ? 'true' : undefined}>
                {icon && <Image src={icon} alt="" width={64} height={64} densities={[1, 2]} />}
                <span>{name}</span>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>

  <div class="wrap gallery-head">
    <p class="small">The same key over {gallery.length} apps. Each list is that app’s own menu bar, with its shortcuts.</p>
  </div>
  <ul class="gallery" aria-label="Apropos over other apps" tabindex="0">
    {gallery.map((g) => {
      const icon = iconFor(g.app);
      return (
        <li>
          <Shot id={g.slot} ratio={4 / 3} zoom={1.3} zoomSmall={1.3} sizes="(max-width: 700px) 110vw, 720px" />
          <p class="g-cap">
            {icon && <Image src={icon} alt="" width={22} height={22} densities={[1, 2]} />}
            {g.app}
          </p>
        </li>
      );
    })}
  </ul>

  {apps.length > 0 && measurement && (
    <div class="wrap explorer" data-explorer>
      <div class="picker" role="tablist" aria-label="Measured apps">
        {apps.map((app, i) => {
          const icon = iconFor(app.name);
          return (
            <button type="button" role="tab" id={`app-tab-${i}`} aria-controls={`app-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab>
              {icon && <Image src={icon} alt="" width={28} height={28} densities={[1, 2]} />}
              <span class="pick-name">{app.name}</span>
              <span class="pick-n num">{fmt(app.total)}</span>
            </button>
          );
        })}
      </div>
      <div class="panels">
        {apps.map((app, i) => (
          <div class="panel" id={`app-panel-${i}`} role="tabpanel" aria-labelledby={`app-tab-${i}`} hidden={i !== 0} data-panel>
            <p class="big">
              <span class="num">{fmt(app.total)}</span>
              <span class="big-label">menu commands in {app.name}</span>
            </p>
            <p class="split">
              <span><strong class="num">{fmt(app.withShortcut)}</strong> with a shortcut</span>
              <span><strong class="num">{fmt(app.withoutShortcut)}</strong> without one</span>
            </p>
            <ul class="menus">
              {topMenus(app).map(([menu, n]) => (
                <li style={`--w:${n / topMenus(app)[0][1]}`}>
                  <span class="menu-name">{menu}</span>
                  <span class="menu-bar" aria-hidden="true"></span>
                  <span class="num">{n}</span>
                </li>
              ))}
            </ul>
            <ul class="cmds" aria-label={`Some ${app.name} commands`}>
              {sample(app).map((c) => (
                <li>
                  <span>{c.title}</span>
                  <kbd class="kbd">{c.shortcut}</kbd>
                </li>
              ))}
            </ul>
            {(app.kind === 'electron' || app.kind === 'web') && (
              <p class="small">{app.name} is built on web views: Apropos lists its menu bar, not the controls inside its window.</p>
            )}
          </div>
        ))}
      </div>
      <p class="small foot">
        Measured on {measurement.measuredOn} on a {measurement.mac}, macOS {measurement.macOS}, with every window as it was.
        <a href="/apps/">Search every measured command</a>
      </p>
    </div>
  )}
</section>

<style>
  .marquee {
    display: grid;
    gap: 18px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .belt {
    display: flex;
    gap: 28px;
    width: max-content;
    animation: belt 70s linear infinite;
  }
  .reverse .belt {
    animation-direction: reverse;
    animation-duration: 80s;
  }
  .marquee:hover .belt {
    animation-play-state: paused;
  }
  @keyframes belt {
    to {
      transform: translateX(-50%);
    }
  }
  .belt li {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 92px;
    font-size: 12px;
    color: var(--ink-3);
    text-align: center;
  }
  .belt img {
    width: 64px;
    height: 64px;
  }
  @media (prefers-reduced-motion: reduce) {
    .belt {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }
    .belt li[aria-hidden] {
      display: none;
    }
    .reverse {
      display: none;
    }
  }

  .gallery-head {
    margin-top: clamp(48px, 6vw, 80px);
    margin-bottom: 18px;
  }
  .gallery {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2));
    padding: 4px max(var(--gutter), calc((100vw - var(--max)) / 2)) 22px;
    scrollbar-width: thin;
  }
  .gallery li {
    flex: none;
    width: min(560px, 84vw);
    scroll-snap-align: start;
    display: grid;
    gap: 10px;
  }
  .g-cap {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
  }
  .g-cap img {
    width: 22px;
    height: 22px;
  }
  .explorer {
    margin-top: clamp(56px, 7vw, 96px);
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 16px 48px;
  }
  .picker {
    display: grid;
    align-content: start;
    max-height: 560px;
    overflow-y: auto;
    border-top: 1px solid var(--line);
  }
  .picker button {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 10px 10px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    text-align: left;
    cursor: pointer;
    color: var(--ink-2);
  }
  .picker img {
    width: 28px;
    height: 28px;
  }
  .picker button[aria-selected='true'] {
    color: var(--ink);
    background: var(--paper-2);
  }
  .pick-name {
    font-weight: 500;
  }
  .pick-n {
    font-size: 14px;
    color: var(--ink-3);
  }
  .panels {
    display: grid;
  }
  .panel {
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    gap: 28px;
  }
  .panel[hidden] {
    display: none;
  }
  .big {
    display: grid;
    gap: 4px;
  }
  .big .num {
    font-family: var(--display);
    font-size: clamp(64px, 8vw, 120px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }
  .big-label {
    font-size: 19px;
    color: var(--ink-2);
  }
  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    color: var(--ink-2);
  }
  .split strong {
    color: var(--ink);
  }
  .menus {
    display: grid;
    gap: 8px;
    max-width: 560px;
  }
  .menus li {
    display: grid;
    grid-template-columns: 110px 1fr 44px;
    align-items: center;
    gap: 12px;
    font-size: 14px;
  }
  .menu-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .menu-bar {
    height: 8px;
    border-radius: 999px;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(var(--w));
  }
  .menus .num {
    text-align: right;
    color: var(--ink-3);
  }
  .cmds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .cmds li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }
  .foot {
    grid-column: 1 / -1;
  }
  @media (max-width: 860px) {
    .explorer {
      grid-template-columns: 1fr;
    }
    .picker {
      display: flex;
      overflow-x: auto;
      max-height: none;
      border: 0;
      gap: 6px;
    }
    .picker button {
      flex: none;
      grid-template-columns: 24px auto;
      border: 0;
      border-radius: 999px;
      padding: 6px 12px 6px 6px;
    }
    .pick-n {
      display: none;
    }
    .cmds {
      grid-template-columns: 1fr;
    }
  }
</style>
