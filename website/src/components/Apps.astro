---
/**
 * Works with your apps: the real panel over 14 apps, switched from a dock of their icons (it moves on by itself while
 * on screen), then every other app as a quiet row of icons, then the explorer of measured apps when apps.json exists.
 */
import { Image } from 'astro:assets';
import { fmt, iconFor, measurement, type MeasuredApp } from '../data/apps';
import Window from './Window.astro';
import type { WindowId } from '../data/windows';

// Real panels (stage captures): each list is that app's own menu bar, read on a real Mac.
const dock: { id: WindowId; app: string }[] = [
  { id: 'app-finder', app: 'Finder' },
  { id: 'app-safari', app: 'Safari' },
  { id: 'app-mail', app: 'Mail' },
  { id: 'app-notes', app: 'Notes' },
  { id: 'app-calendar', app: 'Calendar' },
  { id: 'app-reminders', app: 'Reminders' },
  { id: 'app-music', app: 'Music' },
  { id: 'app-photos', app: 'Photos' },
  { id: 'app-maps', app: 'Maps' },
  { id: 'app-preview', app: 'Preview' },
  { id: 'app-textedit', app: 'TextEdit' },
  { id: 'app-terminal', app: 'Terminal' },
  { id: 'app-xcode', app: 'Xcode' },
  { id: 'app-systemsettings', app: 'System Settings' },
];
const apps = measurement?.apps ?? [];

function sample(app: MeasuredApp) {
  const picked: MeasuredApp['commands'] = [];
  const menus = new Set<string>();
  for (const c of app.commands) {
    const top = c.path[0] ?? '';
    if (!c.shortcut || menus.has(top) || c.title.length > 32) continue;
    menus.add(top);
    picked.push(c);
    if (picked.length === 8) break;
  }
  return picked;
}

function topMenus(app: MeasuredApp) {
  return Object.entries(app.menus)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 6);
}
---
<section id="apps" class="section apps" aria-labelledby="apps-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="apps-title" class="claim">Works in the apps you already have.</h2>
      <p class="lede">
        If an app has a menu bar, Apropos reads it. No plugin per app, and no waiting for anyone to add support. Pick one.
      </p>
    </div>

    <div class="switcher" data-switcher>
      <div class="sw-panels">
        {dock.map((d, i) => (
          <div class="sw-panel" id={`sw-panel-${i}`} role="tabpanel" aria-labelledby={`sw-tab-${i}`} hidden={i !== 0} data-panel>
            <Window id={d.id} width={760} eager={i === 0} class="bleed" />
          </div>
        ))}
      </div>
      <div class="sw-dock" role="tablist" aria-label="Show Apropos over">
        {dock.map((d, i) => {
          const icon = iconFor(d.app);
          return (
            <button type="button" role="tab" id={`sw-tab-${i}`} aria-controls={`sw-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} aria-label={d.app} title={d.app} data-tab>
              {icon && <Image src={icon} alt="" width={48} height={48} densities={[1, 2]} />}
            </button>
          );
        })}
      </div>
    </div>

    <p class="small others">Fourteen of them here. Every other app with a menu bar works the same way.</p>
  </div>

  {apps.length > 0 && measurement && (
    <div class="wrap explorer" data-explorer>
      <div class="picker" role="tablist" aria-label="Measured apps">
        {apps.map((app, i) => {
          const icon = iconFor(app.name);
          return (
            <button type="button" role="tab" id={`app-tab-${i}`} aria-controls={`app-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab>
              {icon && <Image src={icon} alt="" width={28} height={28} densities={[1, 2]} />}
              <span class="pick-name">{app.name}</span>
              <span class="pick-n num">{fmt(app.total)}</span>
            </button>
          );
        })}
      </div>
      <div class="panels">
        {apps.map((app, i) => (
          <div class="panel" id={`app-panel-${i}`} role="tabpanel" aria-labelledby={`app-tab-${i}`} hidden={i !== 0} data-panel>
            <p class="big">
              <span class="num">{fmt(app.total)}</span>
              <span class="big-label">menu commands in {app.name}</span>
            </p>
            <p class="split">
              <span><strong class="num">{fmt(app.withShortcut)}</strong> with a shortcut</span>
              <span><strong class="num">{fmt(app.withoutShortcut)}</strong> without one</span>
            </p>
            <ul class="menus">
              {topMenus(app).map(([menu, n]) => (
                <li style={`--w:${n / topMenus(app)[0][1]}`}>
                  <span class="menu-name">{menu}</span>
                  <span class="menu-bar" aria-hidden="true"></span>
                  <span class="num">{n}</span>
                </li>
              ))}
            </ul>
            <ul class="cmds" aria-label={`Some ${app.name} commands`}>
              {sample(app).map((c) => (
                <li>
                  <span>{c.title}</span>
                  <kbd class="kbd">{c.shortcut}</kbd>
                </li>
              ))}
            </ul>
            {(app.kind === 'electron' || app.kind === 'web') && (
              <p class="small">{app.name} is built on web views: Apropos lists its menu bar, not the controls inside its window.</p>
            )}
          </div>
        ))}
      </div>
      <p class="small foot">
        Measured on {measurement.measuredOn} on a {measurement.mac}, macOS {measurement.macOS}, with every window as it was.
        <a href="/apps/">Search every measured command</a>
      </p>
    </div>
  )}
</section>

<style>
  .apps {
    overflow-x: clip;
  }
  .switcher {
    display: grid;
    justify-items: center;
    gap: 28px;
  }
  .sw-panels {
    display: grid;
    width: min(100%, 760px);
  }
  @media (max-width: 600px) {
    .switcher {
      justify-items: start;
    }
    .sw-dock {
      justify-self: stretch;
      overflow-x: auto;
    }
  }
  .sw-panel {
    grid-area: 1 / 1;
  }
  .sw-panel[hidden] {
    display: block;
    visibility: hidden;
  }
  .sw-dock {
    display: flex;
    gap: 4px;
    max-width: 100%;
    padding: 8px 10px;
    overflow-x: auto;
    border-radius: 22px;
    background: var(--card);
    box-shadow:
      0 0 0 1px var(--line),
      0 18px 40px -24px rgba(0, 0, 0, 0.35);
    scrollbar-width: none;
  }
  .sw-dock button {
    position: relative;
    z-index: 0;
    flex: none;
    padding: 4px 4px 10px;
    border: 0;
    border-radius: 12px;
    background: none;
    cursor: pointer;
  }
  /* Magnification like the real Dock: --mag comes from the pointer's distance (motion.ts). */
  .sw-dock {
    overflow: visible;
  }
  .sw-dock img {
    width: 48px;
    height: 48px;
    transform-origin: 50% 100%;
    transform: translateY(calc((var(--mag, 1) - 1) * -18px)) scale(var(--mag, 1));
    transition: transform 160ms var(--ease);
  }
  .sw-dock button:active img {
    transform: translateY(calc((var(--mag, 1) - 1) * -18px)) scale(calc(var(--mag, 1) * 0.92));
  }
  /* The panel of the app you pick settles in: the app opens it at once, the page only lets it land. */
  .sw-panel:not([hidden]) {
    animation: sw-in 360ms cubic-bezier(0.19, 1, 0.22, 1);
  }
  :global(.flipping) .sw-panel:not([hidden]) {
    animation: none;
  }
  @keyframes sw-in {
    from {
      opacity: 0.4;
      transform: translateY(10px) scale(0.985);
    }
  }
  .sw-dock button[aria-selected='true']::after {
    content: '';
    position: absolute;
    bottom: 1px;
    left: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--pearl);
    box-shadow: 0 0 8px var(--pearl-glow);
  }
  .others {
    margin-top: 18px;
    text-align: center;
  }
  @media (max-width: 560px) {
    .sw-dock img {
      width: 40px;
      height: 40px;
    }
  }
  .explorer {
    margin-top: clamp(56px, 7vw, 96px);
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 16px 48px;
  }
  .picker {
    display: grid;
    align-content: start;
    max-height: 560px;
    overflow-y: auto;
    border-top: 1px solid var(--line);
  }
  .picker button {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 10px 10px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    text-align: left;
    cursor: pointer;
    color: var(--ink-2);
  }
  .picker img {
    width: 28px;
    height: 28px;
  }
  .picker button[aria-selected='true'] {
    color: var(--ink);
    background: var(--paper-2);
  }
  .pick-name {
    font-weight: 500;
  }
  .pick-n {
    font-size: 14px;
    color: var(--ink-3);
  }
  .panels {
    display: grid;
  }
  .panel {
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    gap: 28px;
  }
  .panel[hidden] {
    display: none;
  }
  .big {
    display: grid;
    gap: 4px;
  }
  .big .num {
    font-family: var(--display);
    font-size: clamp(64px, 8vw, 120px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }
  .big-label {
    font-size: 19px;
    color: var(--ink-2);
  }
  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    color: var(--ink-2);
  }
  .split strong {
    color: var(--ink);
  }
  .menus {
    display: grid;
    gap: 8px;
    max-width: 560px;
  }
  .menus li {
    display: grid;
    grid-template-columns: 110px 1fr 44px;
    align-items: center;
    gap: 12px;
    font-size: 14px;
  }
  .menu-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .menu-bar {
    height: 8px;
    border-radius: 999px;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(var(--w));
  }
  .menus .num {
    text-align: right;
    color: var(--ink-3);
  }
  .cmds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .cmds li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }
  .foot {
    grid-column: 1 / -1;
  }
  @media (max-width: 860px) {
    .explorer {
      grid-template-columns: 1fr;
    }
    .picker {
      display: flex;
      overflow-x: auto;
      max-height: none;
      border: 0;
      gap: 6px;
    }
    .picker button {
      flex: none;
      grid-template-columns: 24px auto;
      border: 0;
      border-radius: 999px;
      padding: 6px 12px 6px 6px;
    }
    .pick-n {
      display: none;
    }
    .cmds {
      grid-template-columns: 1fr;
    }
  }
</style>
