---
/**
 * A real window of the app floating on the page: the cutout, a shadow drawn by the page, nothing around it.
 */
import { getImage } from 'astro:assets';
import { win, type WindowId } from '../data/windows';

interface Props {
  id: WindowId;
  /** The widest it is drawn, in CSS pixels, for the image sizes. */
  width: number;
  /** Decorative copies (a second state of the same window) hide from assistive tech. */
  decorative?: boolean;
  eager?: boolean;
  class?: string;
}

const { id, width, decorative = false, eager = false, class: className } = Astro.props;
const w = win(id);
const steps = [Math.round(width), Math.round(width * 1.5), Math.round(width * 2)];

async function set(image: NonNullable<typeof w.dark>) {
  const list = [...new Set(steps.map((s) => Math.min(s, image.width)))];
  const out = await Promise.all(list.map((s) => getImage({ src: image, width: s, format: 'webp', quality: 86 })));
  return { srcset: out.map((o, i) => `${o.src} ${list[i]}w`).join(', '), src: out[0].src };
}

const dark = await set(w.dark);
const light = w.light ? await set(w.light) : null;
const sizes = `(max-width: ${Math.round(width / 0.9)}px) 92vw, ${width}px`;
---
<picture class:list={['win', className]} data-window={id}>
  {light && <source media="(prefers-color-scheme: dark)" srcset={dark.srcset} sizes={sizes} />}
  <img
    src={(light ?? dark).src}
    srcset={(light ?? dark).srcset}
    sizes={sizes}
    width={w.dark.width}
    height={w.dark.height}
    alt={decorative ? '' : w.alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</picture>

<style>
  .win {
    display: block;
  }
  .win img {
    width: 100%;
    height: auto;
    /* The shadow follows the window's own rounded corners. */
    filter: drop-shadow(0 1px 1px rgba(6, 11, 14, 0.18)) drop-shadow(0 24px 40px rgba(6, 11, 14, 0.28));
  }
  /* On phones a big window runs off the right edge at a size you can read, like a window partly off screen. */
  @media (max-width: 600px) {
    .win.bleed {
      width: 150%;
    }
  }
  @media (prefers-color-scheme: dark) {
    .win img {
      filter: drop-shadow(0 0 0.5px rgba(234, 243, 241, 0.35)) drop-shadow(0 28px 48px rgba(0, 0, 0, 0.6));
    }
  }
</style>
