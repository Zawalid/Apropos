---
import Shot from './Shot.astro';

interface Callout {
  /** Position and size of the outlined area, in percent of the image. */
  box: [left: number, top: number, width: number, height: number];
  label: string;
}
interface Chapter {
  id: string;
  title: string;
  body: string;
  shot: string;
  alt: string;
  callout: Callout;
  note?: string;
  early?: boolean;
}

const chapters: Chapter[] = [
  {
    id: 'search',
    title: 'type a few letters. the right command comes first.',
    body: 'Every menu command of the app in front, with its keys. Type part of a name, the first letters of its words, or even a slip like shwo, and the match lights up.',
    shot: 'palette-search-matches',
    alt: 'The Apropos panel with new f typed: New Finder Window and New Folder are listed with the typed letters highlighted in mint.',
    callout: { box: [1.7, 42.2, 96.6, 38.2], label: 'the letters you typed light up' },
  },
  {
    id: 'next',
    title: 'it learns what you run next.',
    body: 'After you run one command, you often run the same one after it. Apropos notices, puts it first, and says why in plain words. It learns on your Mac, from command names, apps and times only.',
    shot: 'palette-usually-next',
    alt: 'The Apropos panel with a Usually next group: Copy 3 Items, with the reason "After Enclosing Folder you chose Copy 3 Items 9 of 12 times", and as Columns.',
    callout: { box: [1.7, 26.8, 96.6, 21.2], label: 'every guess comes with its reason' },
    note: 'Example data.',
  },
  {
    id: 'send',
    title: 'send what you selected without leaving the keyboard.',
    body: 'Notes, Reminders, Things, Obsidian, Bear, a Mail draft or the Share menu, each listed only if the app is installed. A Mail draft is opened for you, never sent.',
    shot: 'palette-send-list',
    alt: 'The Apropos panel listing destinations for the selection: Notes, Mail draft, Reminders, Things, Obsidian, Bear and Share.',
    callout: { box: [7.8, 3.2, 18.8, 4.8], label: 'Escape steps back one level' },
  },
  {
    id: 'sequence',
    title: 'chain steps into one command.',
    body: 'Make the selection uppercase, then send it to Notes. Add steps from any row, run the draft, or save it as a command with its own alias and shortcut.',
    shot: 'palette-sequence-draft',
    alt: 'The Apropos sequence draft: Run sequence, Save as command and Discard draft, then two steps, UPPERCASE and Notes, each with its icon.',
    callout: { box: [1.7, 48, 96.6, 13.8], label: 'step 2 uses the result of step 1' },
  },
  {
    id: 'alias',
    title: 'give any menu item a short name and a key.',
    body: 'Press Command-K on a row and choose Alias and shortcut. Type nf and New Folder comes first. The key runs it in its app, while that app is in front.',
    shot: 'palette-actions',
    alt: 'The Apropos actions menu for New Folder: Run, Add to sequence, Unpin, Hide in Finder, Alias and shortcut, and Copy menu path.',
    callout: { box: [64.5, 73.5, 32.7, 5.3], label: 'any menu item of any app' },
    early: true,
  },
  {
    id: 'record',
    title: 'show it once. it becomes a command.',
    body: 'Record a few menu picks and shortcuts in any app, read each step in plain words, try it without pressing anything, then save it. Typed text and controls are not recorded.',
    shot: 'recording-review',
    alt: 'The Review what you recorded window: three steps with Sturdy and Fair badges, a note that a button click was not recorded, and name, alias and shortcut fields.',
    callout: { box: [6.7, 35, 85, 5.2], label: 'what was skipped is said in place' },
    early: true,
  },
];
---
<section class="tour" id="tour" aria-labelledby="tour-title">
  <div class="wrap">
    <div class="tour-head">
      <h2 id="tour-title" class="title tour-title">what it does, one idea at a time.</h2>
    </div>

    <ol class="chapters">
      {chapters.map((chapter, i) => (
        <li class:list={['chapter', { flip: i % 2 === 1 }]} data-chapter>
          <div class="chapter-copy" data-reveal>
            <h3 class="chapter-title">
              {chapter.title}
              {chapter.early && <span class="tag-early" title="Built and tested on fixtures. Still being checked on real Macs.">early</span>}
            </h3>
            <p class="lead">{chapter.body}</p>
          </div>
          <div class="chapter-shot" data-parallax>
            <Shot name={chapter.shot} alt={chapter.alt} sizes="(max-width: 899px) 94vw, 640px">
              <span
                class="callout"
                style={`left:${chapter.callout.box[0]}%;top:${chapter.callout.box[1]}%;width:${chapter.callout.box[2]}%;height:${chapter.callout.box[3]}%`}
                data-callout
                aria-hidden="true"
              ></span>
            </Shot>
            <p class="chapter-note"><i aria-hidden="true"></i><span>{chapter.callout.label}{chapter.note && <span class="faint"> {chapter.note}</span>}</span></p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .tour { position: relative; z-index: 2; background: var(--ink); padding-block: clamp(80px, 11vw, 160px); }
  .tour-title { max-width: 12em; }
  .chapters { list-style: none; display: grid; gap: clamp(72px, 11vw, 160px); margin-top: clamp(56px, 8vw, 112px); }
  .chapter { display: grid; gap: clamp(28px, 4vw, 56px); align-items: center; }
  @media (min-width: 900px) {
    .chapter { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(48px, 6vw, 96px); }
    .chapter.flip { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
    .chapter.flip .chapter-copy { order: 2; }
  }
  .chapter-copy { display: grid; gap: 18px; align-content: center; }
  .chapter-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.9rem, 3.6vw, 3.3rem); line-height: 0.98; letter-spacing: -0.03em; text-transform: lowercase; }
  .chapter-copy .lead { max-width: 30rem; }
  .chapter-shot { position: relative; }
  .chapter-note { display: flex; align-items: baseline; gap: 10px; margin-top: 16px; color: var(--muted); font-size: 0.95rem; font-weight: 500; }
  .chapter-note i { width: 8px; height: 8px; border-radius: 50%; background: var(--pearl); flex: none; transform: translateY(-1px); }
  .chapter-note .faint { color: var(--faint); font-weight: 400; }

  .callout {
    position: absolute; border: 2px solid var(--mint-mark); border-radius: 14px; pointer-events: none;
    opacity: 0; transform: scale(1.03); transition: opacity 600ms var(--ease-out) 300ms, transform 800ms var(--ease-out) 300ms;
  }
  .callout.is-in { opacity: 1; transform: none; }
  :global(html:not(.motion)) .callout { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .callout { transition: none; } }
</style>
