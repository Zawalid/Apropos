---
import Ring from './Ring.astro';
import Shot from './Shot.astro';
import { links, site, version } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="wrap grid">
    <div class="copy">
      <h1 id="hero-title" class="display title">Every command in every app. One key.</h1>
      <p class="lede">
        Press Option-Space in any Mac app. Apropos lists what that app can do, what you can do with what you selected,
        and the commands you made yourself. Type a few letters, press Return.
      </p>
      <div class="actions" data-hero-cta>
        <a class="pill" href={links.download}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5v9m0 0L4.5 7M8 10.5 11.5 7M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Download for Mac
        </a>
        <button class="quiet" type="button" data-demo-open>See it open</button>
      </div>
      <p class="small meta">Version {version} for macOS {site.minimumMacOS} or later. Nothing about your screen leaves your Mac.</p>
    </div>

    <div class="object">
      <Ring width={560} eager hero />
      <div class="press">
        <button class="key key-opt" type="button" data-demo-open data-press aria-label="Press Option-Space to see Apropos open">
          <span class="glyph" aria-hidden="true">&#8997;</span><span class="word" aria-hidden="true">option</span>
        </button>
        <button class="key key-space" type="button" data-demo-open data-press tabindex="-1" aria-hidden="true">
          <span class="word">space</span>
        </button>
      </div>
      <p class="small hint">Press the keys, or Option-Space on your keyboard.</p>
    </div>
  </div>
</section>

<dialog class="demo" data-demo aria-label="Apropos open over Finder">
  <div class="demo-stage">
    <div class="frames" data-frames>
      <div class="frame on" data-frame="0"><Shot id="demo-open" ratio={1.6} sizes="(min-width: 1000px) 920px, 94vw" /></div>
      <div class="frame" data-frame="1"><Shot id="demo-n" ratio={1.6} sizes="(min-width: 1000px) 920px, 94vw" /></div>
      <div class="frame" data-frame="2"><Shot id="demo-nf" ratio={1.6} sizes="(min-width: 1000px) 920px, 94vw" /></div>
    </div>
    <div class="demo-bar">
      <p class="demo-say" aria-live="polite" data-demo-say>Type <kbd class="kbd">n</kbd> then <kbd class="kbd">f</kbd>, the first letters of New Folder.</p>
      <button class="quiet" type="button" data-demo-close>Close <span class="kbd">esc</span></button>
    </div>
  </div>
</dialog>

<style>
  .hero {
    padding-block: clamp(40px, 7vw, 96px) clamp(24px, 4vw, 48px);
    position: relative;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: center;
  }
  .copy {
    grid-column: 1 / span 7;
    position: relative;
    z-index: 2;
    display: grid;
    gap: 28px;
  }
  .title {
    font-size: clamp(54px, 8.6vw, 124px);
    max-width: 9.4ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }
  .meta {
    max-width: 40ch;
  }
  .object {
    grid-column: 8 / span 5;
    display: grid;
    justify-items: center;
    gap: 18px;
    margin-left: -12%;
  }
  .object :global(.ring) {
    width: min(100%, 560px);
  }
  .press {
    display: flex;
    gap: 10px;
    margin-top: -6px;
  }
  .key {
    position: relative;
    display: grid;
    align-content: space-between;
    height: 72px;
    padding: 11px 13px;
    border: 0;
    border-radius: 12px;
    background: var(--key);
    color: var(--key-ink);
    box-shadow:
      0 0 0 1px var(--line-2),
      0 4px 0 var(--key-edge),
      0 14px 24px -14px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    text-align: left;
    transition:
      transform 90ms var(--ease),
      box-shadow 90ms var(--ease);
  }
  .key-opt {
    width: 84px;
  }
  .key-space {
    width: 220px;
    align-content: end;
  }
  .glyph {
    justify-self: end;
    font-size: 15px;
    line-height: 1;
  }
  .word {
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    color: var(--ink-2);
  }
  .key:global(.down),
  .key:active {
    transform: translateY(3px);
    box-shadow:
      0 0 0 1px var(--line-2),
      0 1px 0 var(--key-edge),
      0 8px 16px -12px rgba(0, 0, 0, 0.3);
  }
  .hint {
    text-align: center;
  }

  /* The demo opens where the app opens its panel: the middle at 46% down the screen. */
  .demo {
    width: min(960px, calc(100vw - 24px));
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    position: fixed;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    border: 0;
    background: none;
    color: var(--ink);
    overflow: visible;
  }
  .demo::backdrop {
    background: color-mix(in srgb, var(--paper) 55%, transparent);
  }
  .demo[open] .demo-stage {
    animation: demo-in 180ms var(--ease);
  }
  @keyframes demo-in {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
  }
  .frames {
    display: grid;
  }
  .frame {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 120ms var(--ease);
  }
  .frame.on {
    opacity: 1;
  }
  .demo-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    margin-top: 14px;
    padding: 6px 8px 6px 18px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--line);
  }
  .demo-say {
    font-size: 15px;
    color: var(--ink-2);
  }

  @media (max-width: 1023px) {
    .copy,
    .object {
      grid-column: 1 / -1;
    }
    .object {
      margin: 32px 0 0;
    }
    .object :global(.ring) {
      width: min(78%, 420px);
    }
  }
  @media (max-width: 520px) {
    .key {
      height: 60px;
    }
    .key-opt {
      width: 70px;
    }
    .key-space {
      width: 170px;
    }
  }
</style>
