---
import { links } from '../data/site';
const faq: [string, string][] = [
  ['Does it replace Raycast?', 'No. Raycast is a launcher: apps, files, clipboard, windows, snippets. Apropos does none of that. It lists what the app in front of you can do and what you can do with what you selected. It has its own key, Option-Space, so both can stay installed.'],
  ['Why does it need Accessibility?', 'To read the menu bar of the app in front and to press the item you choose. Accessibility does not work inside the sandbox that the Mac App Store requires, so Apropos is distributed directly.'],
  ['Does it send anything anywhere?', 'No. There is no account and no server. Apropos reads the app in front only when you open the panel, keeps a few small files in your Library, and never records what you type, select or copy. The Privacy and data page in the app shows what is kept, with a Forget button for each.'],
  ['Can it press something I did not choose?', 'No. A menu item runs when you pick it in the panel or press the key you gave it. Your own commands ask the first time they run, and imported commands wait for your approval before they can run at all.'],
  ['Which apps does it work with?', 'Any app with a menu bar. Apps that fill a menu in only when it is opened, parts of Xcode for one, show those items once the app has built them.'],
  ['What does it learn about me?', 'Which command you usually run after another, per app and time of day. It stores command names, apps and times, never selections, web addresses, document names or queries. Reset or pause learning from Settings or the menu bar.'],
  ['Can I record a command?', 'Early, yes. It records menu clicks and keyboard shortcuts, shows each step in plain words, and lets you try it without pressing anything before you save. Controls and typed text are not recorded, and it has not been tried on many Macs yet.'],
  ['Can another app run my commands?', 'Only commands you marked for it, and only after you confirm the first run. They work through apropos:// links and Shortcuts, so Raycast quicklinks, Alfred and Terminal can call them.'],
  ['Why does macOS warn me the first time?', 'Apropos is not notarized yet. The source is open if you want to read it before you run it.'],
  ['Does it update itself?', 'Not yet. The Updates page in the app says automatic updates arrive with the first public release.'],
];
---
<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-head">
      <h2 id="faq-title" class="title">questions.</h2>
      <p class="lead">Something missing? <a class="link strong" href={links.issues}>Ask on GitHub</a>.</p>
    </div>
    <div class="faq-list">
      {faq.map(([q, a]) => (
        <details data-faq>
          <summary><span>{q}</span><span class="plus" aria-hidden="true"></span></summary>
          <div class="answer"><p>{a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { position: relative; z-index: 2; background: var(--ink); padding-block: clamp(96px, 12vw, 180px); }
  .faq-grid { display: grid; gap: 40px; }
  @media (min-width: 960px) { .faq-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: 64px; } }
  .faq-head { display: grid; gap: 16px; align-content: start; }
  .strong { color: var(--mint); font-weight: 700; }
  .faq-list { border-top: 1px solid var(--line-strong); }
  details { border-bottom: 1px solid var(--line-strong); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding: 24px 0; font-weight: 700; font-size: clamp(1.1rem, 1.5vw, 1.3rem); letter-spacing: -0.01em;
    transition: color 200ms var(--ease-out);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--mint); }
  summary:focus-visible { outline-offset: 6px; }
  .plus { position: relative; flex: none; width: 18px; height: 18px; }
  .plus::before, .plus::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: currentColor; border-radius: 2px; transition: transform 320ms var(--ease-out); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0deg); }
  .answer { overflow: hidden; }
  .answer p { padding-bottom: 26px; color: var(--muted); max-width: 40rem; }
</style>
