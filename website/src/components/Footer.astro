---
import Ring from './Ring.astro';
import { links, version } from '../data/site';
import { measurement } from '../data/apps';
---
<footer class="foot">
  <div class="wrap inner">
    <div class="art">
      <Ring width={220} />
      <p class="sign">The ring is the place, the pearl is the moment.</p>
    </div>
    <nav class="cols" aria-label="Footer">
      <div>
        <h2>Apropos</h2>
        <ul>
          <li><a href="/#install">Download</a></li>
          <li><a href={links.changelog}>Changelog</a></li>
          {measurement && <li><a href="/apps/">Measured apps</a></li>}
        </ul>
      </div>
      <div>
        <h2>Compare</h2>
        <ul>
          <li><a href="/compare/">Overview</a></li>
          <li><a href="/compare/raycast/">Raycast</a></li>
          <li><a href="/compare/spotlight/">Spotlight</a></li>
          <li><a href="/compare/alfred/">Alfred</a></li>
        </ul>
      </div>
      <div>
        <h2>Help</h2>
        <ul>
          <li><a href={links.issues}>Report a problem</a></li>
          <li><a href={links.safetyDoc}>How actions stay safe</a></li>
          <li><a href={links.repo}>GitHub</a></li>
        </ul>
      </div>
    </nav>
    <p class="small legal">Apropos {version}. Made by <a href={links.author}>Walid</a>. This site uses no cookies and no analytics.</p>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(120px, 14vw, 200px);
    padding-block: clamp(48px, 6vw, 80px) 40px;
    border-top: 1px solid var(--line);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
  }
  .art {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .art :global(.ring) {
    width: 200px;
  }
  .sign {
    font-family: var(--display);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
    max-width: 18ch;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .cols h2 {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-3);
    margin-bottom: 12px;
  }
  .cols ul {
    display: grid;
    gap: 8px;
  }
  .cols a {
    color: var(--ink);
    text-decoration: none;
    font-size: 15px;
  }
  .cols a:hover {
    text-decoration: underline;
  }
  .legal {
    grid-column: 1 / -1;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
    }
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
