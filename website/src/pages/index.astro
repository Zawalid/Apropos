---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Gap from '../components/Gap.astro';
import Story from '../components/Story.astro';
import Holding from '../components/Holding.astro';
import Yours from '../components/Yours.astro';
import Apps from '../components/Apps.astro';
import Compare from '../components/Compare.astro';
import Private from '../components/Private.astro';
import Install from '../components/Install.astro';
import { faq } from '../data/faq';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---
<Base home extraJsonLd={[faqLd]}>
  <Hero />
  <Gap />
  <Story />
  <Holding />
  <Apps />
  <Yours />
  <Compare />
  <Private />
  <Install />
</Base>
