---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Apropos" description="That page does not exist. Go back to the Apropos home page to see what Apropos does and download it for your Mac." path="/404/" noindex>
  <section class="wrap nf">
    <h1 class="display">This page is not here.</h1>
    <p class="lede">The address may be old, or mistyped. <a href="/">Go to the home page</a>.</p>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 28px;
    justify-items: start;
    padding-block: clamp(64px, 10vw, 140px);
    min-height: 70vh;
  }
  h1 {
    font-size: clamp(44px, 7vw, 96px);
    max-width: 12ch;
  }
</style>
