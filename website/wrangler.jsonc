{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apropos",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "apropos.zawalid.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
