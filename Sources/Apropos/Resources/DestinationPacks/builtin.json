{
  "schemaVersion": 1,
  "name": "Apropos destinations",
  "destinations": [
    {
      "id": "dest:notes",
      "title": "Notes",
      "subtitle": "New note",
      "symbol": "note.text",
      "app": "com.apple.Notes",
      "accepts": [
        "text",
        "page"
      ],
      "keywords": [
        "note",
        "apple notes"
      ],
      "timeout": 20,
      "failureHint": "If macOS asked to let Apropos control Notes, allow it in Privacy & Security, Automation.",
      "variants": [
        {
          "kinds": [
            "page"
          ],
          "backend": {
            "type": "appleScript",
            "sourceLines": [
              "on run argv",
              "  set noteTitle to item 1 of argv",
              "  set noteBody to item 2 of argv",
              "  set noteLink to item 3 of argv",
              "  if noteBody is \"\" then",
              "    set html to \"<div><h1>\" & my escape(noteTitle) & \"</h1></div>\"",
              "  else",
              "    set html to \"<div>\" & my escape(noteBody) & \"</div>\"",
              "  end if",
              "  if noteLink is not \"\" then",
              "    set html to html & \"<div><br></div><div><a href=\\\"\" & my escape(noteLink) & \"\\\">\" & my escape(noteLink) & \"</a></div>\"",
              "  end if",
              "  tell application \"Notes\" to make new note with properties {body:html}",
              "end run",
              "on escape(t)",
              "  set t to my replace(t, \"&\", \"&amp;\")",
              "  set t to my replace(t, \"<\", \"&lt;\")",
              "  set t to my replace(t, \">\", \"&gt;\")",
              "  set t to my replace(t, \"\\\"\", \"&quot;\")",
              "  set t to my replace(t, return & linefeed, linefeed)",
              "  set t to my replace(t, return, linefeed)",
              "  return my replace(t, linefeed, \"<br>\")",
              "end escape",
              "on replace(t, find, repl)",
              "  set saved to AppleScript's text item delimiters",
              "  set AppleScript's text item delimiters to find",
              "  set pieces to text items of t",
              "  set AppleScript's text item delimiters to repl",
              "  set t to pieces as text",
              "  set AppleScript's text item delimiters to saved",
              "  return t",
              "end replace"
            ],
            "arguments": [
              "--",
              "{title}",
              "",
              "{url}"
            ]
          }
        },
        {
          "kinds": [
            "text"
          ],
          "backend": {
