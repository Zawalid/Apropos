    {
      "id": "dest:reminders",
      "title": "Reminders",
      "subtitle": "New reminder",
      "symbol": "checklist",
      "app": "com.apple.reminders",
      "accepts": [
        "text",
        "page"
      ],
      "keywords": [
        "reminder",
        "todo",
        "task"
      ],
      "timeout": 20,
      "failureHint": "If macOS asked to let Apropos control Reminders, allow it in Privacy & Security, Automation.",
      "variants": [
        {
          "kinds": [
            "page"
          ],
          "backend": {
            "type": "appleScript",
            "sourceLines": [
              "on run argv",
              "  set reminderName to item 1 of argv",
              "  set reminderBody to item 2 of argv",
              "  set reminderLink to item 3 of argv",
              "  if reminderBody is reminderName then set reminderBody to \"\"",
              "  if reminderLink is not \"\" then",
              "    if reminderBody is not \"\" then set reminderBody to reminderBody & linefeed & linefeed",
              "    set reminderBody to reminderBody & reminderLink",
              "  end if",
              "  tell application \"Reminders\" to make new reminder with properties {name:reminderName, body:reminderBody}",
              "end run"
            ],
            "arguments": [
              "--",
              "{title}",
              "",
              "{url}"
            ]
          }
        },
