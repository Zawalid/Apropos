    {
      "id": "dest:mail",
      "title": "Mail draft",
      "subtitle": "Opens a draft, never sends",
      "symbol": "envelope",
      "app": "com.apple.mail",
      "accepts": [
        "text",
        "page",
        "files"
      ],
      "keywords": [
        "email",
        "compose",
        "message"
      ],
      "confirm": "preview",
      "preview": "Open a draft in Mail",
      "timeout": 25,
      "failureHint": "If macOS asked to let Apropos control Mail, allow it in Privacy & Security, Automation.",
      "variants": [
        {
          "kinds": [
            "files"
          ],
          "backend": {
            "type": "appleScript",
            "sourceLines": [
              "on run argv",
              "  set draftSubject to item 1 of argv",
              "  set draftBody to item 2 of argv",
              "  set draftLink to item 3 of argv",
              "  if draftLink is not \"\" then",
              "    if draftBody is not \"\" then set draftBody to draftBody & linefeed & linefeed",
              "    set draftBody to draftBody & draftLink",
              "  end if",
              "  tell application \"Mail\"",
              "    set draft to make new outgoing message with properties {subject:draftSubject, content:draftBody, visible:true}",
              "    repeat with i from 4 to count of argv",
              "      set attachmentPath to item i of argv",
              "      tell content of draft to make new attachment with properties {file name:(POSIX file attachmentPath as alias)} at after the last paragraph",
              "    end repeat",
              "    activate",
              "  end tell",
              "end run"
            ],
            "arguments": [
              "--",
              "{title}",
              "",
              "",
              "{files}"
            ]
          }
        },
        {
          "kinds": [
            "page"
          ],
          "backend": {
